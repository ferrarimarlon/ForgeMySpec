{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "FORGEMYSPEC_HARNESS=\"${CLAUDE_PLUGIN_ROOT}/harness\" PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/harness\" python3 -m forgemyspec hook pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FORGEMYSPEC_HARNESS=\"${CLAUDE_PLUGIN_ROOT}/harness\" PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/harness\" python3 -m forgemyspec hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FORGEMYSPEC_HARNESS=\"${CLAUDE_PLUGIN_ROOT}/harness\" PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/harness\" python3 -m forgemyspec hook user-prompt-submit",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FORGEMYSPEC_HARNESS=\"${CLAUDE_PLUGIN_ROOT}/harness\" PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}/harness\" python3 -m forgemyspec hook stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
