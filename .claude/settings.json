{
  "defaultAgent": "forgemyspec-default",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && PYTHONPATH=src python3 -m forgemyspec.board hook-stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
